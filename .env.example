# Copiar este archivo como .env y completar los valores.
# El .env real NUNCA se sube al repositorio: este repo es publico.

# "desarrollo" o "produccion". En produccion la aplicacion se niega a arrancar
# si la clave de firma sigue siendo la de desarrollo.
ENTORNO=desarrollo

# Base de datos. En desarrollo un archivo SQLite; en produccion, Postgres:
# postgresql+psycopg://usuario:clave@servidor/nombre
DATABASE_URL=sqlite:///./motorping.db

# Dominios del frontend autorizados a llamar la API, separados por coma.
FRONTEND_ORIGINS=http://localhost:3000

# Clave con que se firman los tokens de sesion.
# Generar una propia con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=desarrollo-inseguro-cambiar-en-produccion

# Clave para dar de alta talleres en POST /auth/register.
# Vacia = el alta esta cerrada. Generarla igual que la de arriba.
ADMIN_API_KEY=
